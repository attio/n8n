{
	"name": "@attio/n8n-nodes-attio",
	"version": "0.1.0",
	"description": "n8n community node for Attio",
	"license": "MIT",
	"homepage": "https://github.com/attio/n8n#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"attio",
		"crm"
	],
	"author": {
		"name": "Eoghan Mulcahy",
		"email": "eoghan.mulcahy@attio.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/attio/n8n.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AttioApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Attio/Attio.node.js",
			"dist/nodes/Attio/AttioTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.2",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2",
		"zod": "3.25.76"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"packageManager": "pnpm@11.26.0"
}
